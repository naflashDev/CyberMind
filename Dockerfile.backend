FROM python:3.12-slim

# Evitar prompts y configurar buffers de salida
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    RUNNING_IN_DOCKER=true

WORKDIR /app

# Instalar nmap, ping, git y curl (sin build-essential para mantener la imagen ligera)
RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap \
    iputils-ping \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Instalar dependencias de Python y purgar paquetes transitivos no utilizados en local y cachés/tests
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip uninstall -y kubernetes kubernetes_asyncio onnxruntime tokenizers huggingface-hub hf-xet pip setuptools wheel \
    && find /usr/local/lib/python3.12 -type d \( -name "__pycache__" -o -name "tests" -o -name "test" \) -prune -exec rm -rf {} + \
    && find /usr/local/lib/python3.12 -type f \( -name "*.pyc" -o -name "*.pyo" -o -name "*.a" \) -delete

# Copiar el código fuente y la documentación del proyecto
COPY src/ ./src/
COPY Docs/ ./Docs/
COPY README.md ./README.md
COPY cfg.ini* ./src/
COPY cfg_services.ini* ./src/

EXPOSE 8000

WORKDIR /app/src
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
